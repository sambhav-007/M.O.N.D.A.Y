# M.O.N.D.A.Y. — Git Ignore Rules for Security & Environment Confidentiality

# 🔒 Google Cloud OAuth Credentials & Auth Tokens
data/credentials.json*
data/google_token.json*

# 🔒 Databases & Local Memories
data/memories.db
data/memory.db
data/*.db
data/staging/

# Machine-generated runtime artifacts. These are rewritten on every run and
# caused repeated merge conflicts; the voice profile also embeds an absolute
# path to the machine that trained it. Both regenerate automatically.
data/action_history.jsonl
data/action_history.json
data/action_history.*.tmp
data/action_history.corrupt-*.json
models/monday_voice_profile.joblib

# Runtime calendar store. The agent appends an event on every scheduling call
# (the test suite adds one per run), so a tracked copy is pure churn and would
# conflict on every merge exactly as action_history.json did. Both call sites
# in agents/comms_agent.py create it on demand when absent.
data/calendar.json

# Python runtime & byte-code
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment files
.env
.env.local
.env.*
!.env.example

# Runtime logs. Nothing here is reproducible and agent logs can echo command
# text (recipients, draft bodies), so they must never be committed.
logs/
*.log

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Private Local Documentation Suite
docs/

