# ─────────────────────────────────────────────────────────────────────────────
#  Environment Variables — M.O.N.D.A.Y. ML Backend
#  Copy this file to .env and fill in values before running the API server.
#  Never commit a populated .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# ML model storage directory (relative to project root)
MODEL_DIR=./models

# Data directory (synthetic datasets are generated in-code; set this if
# you swap in real data later)
DATA_DIR=./data

# Optional: OpenAI / cloud LLM key (not used by the 5 ML modules — only
# needed if you extend the FastAPI server to proxy LLM calls)
# OPENAI_API_KEY=sk-...

# SHAP explainer settings
XAI_MAX_SAMPLES=200
