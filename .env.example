# ─────────────────────────────────────────────────────────────────────────────
#  Environment Variables — M.O.N.D.A.Y. ML Backend
#  Copy this file to .env and fill in values before running the API server.
#  Never commit a populated .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# ML model storage directory (relative to project root)
MODEL_DIR=./models

# Data directory (synthetic datasets are generated in-code; set this if
# you swap in real data later)
DATA_DIR=./data

# Optional: OpenAI / cloud LLM key (not used by the 5 ML modules — only
# needed if you extend the FastAPI server to proxy LLM calls)
# OPENAI_API_KEY=sk-...

# ── Outgoing email (SMTP) ────────────────────────────────────────────────────
# Required for M.O.N.D.A.Y. to actually SEND mail. Without these it will still
# compose and save drafts, but will report that sending is not configured.
#
# For Gmail you must use an App Password, NOT your normal account password:
#   1. Enable 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords  →  create one for "Mail"
#   3. Paste the 16-character value below (spaces are ignored)
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
#
# Optional — defaults shown. Port 465 switches to implicit SSL, 587 uses STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=you@gmail.com

# SHAP explainer settings
XAI_MAX_SAMPLES=200
