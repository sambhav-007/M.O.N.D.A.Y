# ─────────────────────────────────────────────────────────────────────────────
#  Environment Variables — M.O.N.D.A.Y. ML Backend
#  Copy this file to .env and fill in values before running the API server.
#  Never commit a populated .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# ML model storage directory (relative to project root)
MODEL_DIR=./models

# Data directory (synthetic datasets are generated in-code; set this if
# you swap in real data later)
DATA_DIR=./data

# Optional: OpenAI / cloud LLM key (not used by the 5 ML modules — only
# needed if you extend the FastAPI server to proxy LLM calls)
# OPENAI_API_KEY=sk-...

# ── Stage 3, the local language model ────────────────────────────────────────
# Optional in the strongest sense: with no Ollama server running, the router
# ends at stage 2 exactly as it always did, and nothing here changes that.
# Nothing typed is sent anywhere — Ollama is local, which is most of why it was
# chosen over a hosted API.
#
# MONDAY_LLM_MODEL picks the model. Left unset, the first of PREFERRED_MODELS
# your Ollama server actually has is used — llama3.2:3b first, because it
# measured BETTER than the 8B, not merely cheaper: 66.1% vs 64.3% on 339 real
# utterances, at p50 0.7s vs 1.8s. An 8B does fit on a 6 GiB card; it just did
# not help. Regenerate the comparison for your own machine with:
#
#   py -3.12 -m reports.stage3_selection --model llama3.2:3b --model llama3.1:8b
#
# MONDAY_LLM_MODEL=llama3.2:3b
# MONDAY_LLM_HOST=http://127.0.0.1:11434
#
# MONDAY_LLM=off switches stage 3 off entirely, so a demo can guarantee the
# deterministic path is what is being shown.
# MONDAY_LLM=off

# ── Stage 4, an optional hosted model (ROADMAP Phase 13) ─────────────────────
# Reached only when every stage before it declined: no pattern, no confident
# classification, and no local model able to answer. Without GEMINI_API_KEY it
# never runs, and the router behaves exactly as it did before it existed.
#
# It ANSWERS; it does not act. Stage 4 is never offered the skill schema and its
# reply is never read as a tool call, so there is no route from it to an action —
# the containment is the absence of a code path rather than a filter that has to
# hold. Its answers carry ModelAnswered evidence with host="remote", so you can
# tell an answer that left this machine from one that did not.
#
# MONDAY_REMOTE_LLM=off switches it off even with a key present.
# MONDAY_REMOTE_LLM=off

# ── Outgoing email (SMTP) ────────────────────────────────────────────────────
# Required for M.O.N.D.A.Y. to actually SEND mail. Without these it will still
# compose and save drafts, but will report that sending is not configured.
#
# For Gmail you must use an App Password, NOT your normal account password:
#   1. Enable 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords  →  create one for "Mail"
#   3. Paste the 16-character value below (spaces are ignored)
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
#
# Optional — defaults shown. Port 465 switches to implicit SSL, 587 uses STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=you@gmail.com

# SHAP explainer settings
XAI_MAX_SAMPLES=200
